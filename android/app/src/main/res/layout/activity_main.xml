<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <!-- Stats bar at top -->
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading..."
            android:textColor="#aaa"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Movies"
            android:textColor="#2ecc71"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh Plex"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_history"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="History" />
    </LinearLayout>

    <!-- Undo banner -->
    <include
        android:id="@+id/undoBanner"
        layout="@layout/undo_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top" />

    <!-- Card stack area -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="90dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Gesture hints -->
    <TextView
        android:id="@+id/tvSwipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="70dp"
        android:text="← block  ·  keep →  ·  ⭐ super keep ↓"
        android:textColor="#555"
        android:textSize="11sp" />

    <!-- Bottom action buttons - minimal circles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <!-- Block button (red circle) -->
        <FrameLayout
            android:id="@+id/btnBlock"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/circle_red"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_x"
                android:contentDescription="Block"
                app:tint="@android:color/white"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </FrameLayout>

        <!-- Skip button (yellow circle, smaller) -->
        <FrameLayout
            android:id="@+id/btnSkip"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/circle_yellow"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_skip"
                android:contentDescription="Skip"
                app:tint="@android:color/white"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </FrameLayout>

        <!-- Keep button (green circle) -->
        <FrameLayout
            android:id="@+id/btnKeep"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_green"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart"
                android:contentDescription="Keep"
                app:tint="@android:color/white"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
