[Unit]
Description=Movie Swipe Backend API
After=network.target

[Service]
Type=simple
User=roy
WorkingDirectory=/home/roy/projects/movie-swipe
ExecStart=/usr/bin/python3 /home/roy/projects/movie-swipe/backend.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
